{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyFoam Promotion and Retention Record",
  "description": "Human decision, authorized application, post-apply validation, retention, and rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "candidate_id",
    "candidate_ref",
    "decision",
    "application",
    "post_apply_validation",
    "retention",
    "limitations",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "$ref": "#/$defs/relativePath"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reviewer",
        "reason",
        "decided_at"
      ],
      "properties": {
        "action": {
          "enum": [
            "apply",
            "apply_limited",
            "revise",
            "reject",
            "defer"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "target_ref",
        "pre_hashes",
        "post_hashes",
        "evidence_refs",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "authorized",
            "applied",
            "failed",
            "rolled_back"
          ]
        },
        "target_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "pre_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileHash"
          }
        },
        "post_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileHash"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "summary": {
          "type": "string"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "post_apply_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "limited",
            "blocked"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "retained",
            "retained_limited",
            "blocked",
            "not_applicable",
            "rolled_back"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reason",
        "rolled_back_at",
        "evidence_refs"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rolled_back_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "revise",
                  "reject",
                  "defer"
                ]
              }
            }
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "application": {
            "properties": {
              "status": {
                "const": "not_requested"
              }
            }
          },
          "retention": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "apply",
                  "apply_limited"
                ]
              }
            }
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "application": {
            "properties": {
              "status": {
                "enum": [
                  "authorized",
                  "applied",
                  "failed",
                  "rolled_back"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "status": {
                "const": "retained"
              }
            }
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "properties": {
          "application": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "post_apply_validation": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "status": {
                "const": "retained_limited"
              }
            }
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "required": [
          "limitations"
        ],
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "enum": [
                  "apply",
                  "apply_limited"
                ]
              }
            }
          },
          "application": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "post_apply_validation": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "limited"
                ]
              }
            }
          },
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application": {
            "properties": {
              "status": {
                "const": "rolled_back"
              }
            }
          }
        },
        "required": [
          "application"
        ]
      },
      "then": {
        "required": [
          "rollback"
        ],
        "properties": {
          "retention": {
            "properties": {
              "status": {
                "const": "rolled_back"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "status": {
                "const": "rolled_back"
              }
            }
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "required": [
          "rollback"
        ],
        "properties": {
          "application": {
            "properties": {
              "status": {
                "const": "rolled_back"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "application"
        ]
      },
      "then": {
        "properties": {
          "application": {
            "properties": {
              "target_ref": {
                "$ref": "#/$defs/relativePath"
              },
              "applied_at": {
                "type": "string",
                "format": "date-time"
              },
              "pre_hashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/fileHash"
                }
              },
              "post_hashes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/fileHash"
                }
              }
            },
            "required": [
              "target_ref",
              "pre_hashes",
              "post_hashes",
              "applied_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "status": {
                "enum": [
                  "retained",
                  "retained_limited",
                  "rolled_back"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "properties": {
          "retention": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reviewer",
              "decided_at",
              "reason"
            ]
          }
        }
      }
    }
  ]
}
