{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyFoam Experience Record",
  "description": "One bounded evidence-linked Workflow experience; not a generic rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experience_id",
    "kind",
    "case_id",
    "source_workflow_ref",
    "responsible_skill",
    "summary",
    "pattern",
    "scope",
    "evidence_refs",
    "candidate_eligible",
    "eligibility_reason",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "verified_repair",
        "successful_pattern",
        "failure_pattern",
        "unresolved_failure"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_workflow_ref": {
      "$ref": "#/$defs/relativePath"
    },
    "source_run_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "source_evidence_summary_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "responsible_skill": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "SKILL\\.md$"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "outcome"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "change_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "exclusions"
      ],
      "properties": {
        "applicability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "candidate_eligible": {
      "type": "boolean"
    },
    "eligibility_reason": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker",
        "attempted_actions",
        "remaining_risk",
        "next_action"
      ],
      "properties": {
        "blocker": {
          "type": "string",
          "minLength": 1
        },
        "attempted_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remaining_risk": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "failure_pattern"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "unresolved"
        ],
        "properties": {
          "candidate_eligible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "successful_pattern",
              "verified_repair"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "required": [
              "execution_gate",
              "numerical_gate",
              "physical_gate",
              "physics_grounded_qoi_gate"
            ],
            "properties": {
              "execution_gate": {
                "const": true
              },
              "numerical_gate": {
                "const": true
              },
              "physical_gate": {
                "const": true
              },
              "physics_grounded_qoi_gate": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unresolved_failure"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "unresolved"
        ],
        "properties": {
          "candidate_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verified_repair"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "source_run_refs"
        ],
        "properties": {
          "source_run_refs": {
            "minItems": 1
          },
          "metadata": {
            "required": [
              "before_gates"
            ],
            "properties": {
              "before_gates": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "boolean"
                },
                "anyOf": [
                  {
                    "properties": {
                      "execution_gate": {
                        "const": false
                      }
                    },
                    "required": [
                      "execution_gate"
                    ]
                  },
                  {
                    "properties": {
                      "numerical_gate": {
                        "const": false
                      }
                    },
                    "required": [
                      "numerical_gate"
                    ]
                  },
                  {
                    "properties": {
                      "physical_gate": {
                        "const": false
                      }
                    },
                    "required": [
                      "physical_gate"
                    ]
                  },
                  {
                    "properties": {
                      "physics_grounded_qoi_gate": {
                        "const": false
                      }
                    },
                    "required": [
                      "physics_grounded_qoi_gate"
                    ]
                  }
                ]
              }
            }
          },
          "pattern": {
            "properties": {
              "root_cause": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "before_sha256": {
                "type": "string",
                "minLength": 1
              },
              "after_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "root_cause",
              "action",
              "before_sha256",
              "after_sha256"
            ]
          }
        }
      }
    }
  ]
}
