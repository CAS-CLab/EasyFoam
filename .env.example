# Bash example: set these in the shell used by your coding agent.
# Replace the bashrc path with your actual installation path.
# EasyFoam does not automatically load .env files.
# For PowerShell, use the $env: syntax documented in the README.
# Configure model endpoints and credentials in your agent runtime separately.
export EASYFOAM_OPENFOAM_BASHRC="/opt/openfoam13/etc/bashrc"
export EASYFOAM_EXEC_BACKEND="auto"
